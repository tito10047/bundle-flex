{
    "name": "yceruto/bundle-skeleton",
    "type": "project",
    "description": "A minimal Symfony bundle skeleton recommended to create new bundles",
    "keywords": ["symfony", "bundle", "skeleton"],
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "yceruto/bundle-flex": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yceruto/bundle-flex": true
        }
    }
}
