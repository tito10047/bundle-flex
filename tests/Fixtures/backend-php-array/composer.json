{
    "name": "acme/backend-php-array-bundle",
    "description": "AcmeBackendPhpArrayBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "doctrine"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.4",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.9",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.6.4",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\BackendPhpArrayBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\BackendPhpArrayBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "qa": [
            "@test",
            "@phpstan",
            "@cs",
            "@rector"
        ],
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Checks the coding standards (PHP-CS-Fixer)",
        "cs:fix": "Fixes the coding standards (PHP-CS-Fixer)",
        "phpstan": "Runs the static analysis (PHPStan)",
        "qa": "Runs every quality check",
        "rector": "Checks the code for automated refactorings (Rector)",
        "rector:fix": "Applies the automated refactorings (Rector)",
        "test": "Runs the tests (PHPUnit)"
    }
}
