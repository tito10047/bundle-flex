{
    "name": "acme/ux-bundle",
    "description": "AcmeUxBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/asset-mapper": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\UxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\UxBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "qa": [
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "qa": "Runs every quality check",
        "test": "Runs the tests (PHPUnit)"
    }
}
