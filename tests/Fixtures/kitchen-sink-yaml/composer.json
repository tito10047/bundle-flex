{
    "name": "my-vendor/yaml-kitchen-sink-bundle",
    "description": "MyVendorYamlKitchenSinkBundle for Symfony",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "kitchen-sink"
    ],
    "authors": [
        {
            "name": "Jane Doe",
            "email": "jane@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\YamlKitchenSinkBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\YamlKitchenSinkBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@php -l src/",
            "@test"
        ],
        "qa": [
            "@test",
            "@lint"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "qa": "Runs every quality check",
        "test": "Runs the tests"
    }
}
