{
    "name": "yceruto/bundle-flex",
    "description": "Composer plugin that turns the Symfony bundle skeleton into a ready-to-use, best-practices compliant bundle",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "skeleton",
        "composer-plugin"
    ],
    "authors": [
        {
            "name": "Yonel Ceruto",
            "email": "yonelceruto@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer-plugin-api": "^2.6"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Yceruto\\BundleFlex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yceruto\\BundleFlex\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "class": "Yceruto\\BundleFlex\\Flex"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Checks coding standards (PHP-CS-Fixer, dry run)",
        "cs:fix": "Fixes coding standards (PHP-CS-Fixer)",
        "phpstan": "Runs static analysis (PHPStan, level max)",
        "qa": "Runs every quality check: coding standards, static analysis and tests",
        "test": "Runs the test suite (PHPUnit)"
    }
}
